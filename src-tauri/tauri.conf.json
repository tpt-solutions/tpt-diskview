{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "tpt-diskview",
  "version": "0.1.0",
  "identifier": "com.tpt-solutions.diskview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpt-diskview",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) tpt-solutions 2026",
    "publisher": "tpt-solutions",
    "shortDescription": "A fast, modern disk space analyzer",
    "longDescription": "tpt-diskview is a fast, modern disk space analyzer built with Tauri and Rust.",
    "windows": {
      "wix": {
        "language": "en-US",
        "template": "default"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
